{
  "schemaVersion": 3,
  "kind": "sdkwork.app",
  "app": {
    "key": "sdkwork-messaging-pc",
    "name": "SDKWork Messaging PC",
    "displayName": "SDKWork Notification Center",
    "description": "Commercial notification center for SDKWork applications and cloud services.",
    "vendor": "SDKWork",
    "officialWebsiteUrl": "https://sdkwork.com/apps/sdkwork-messaging-pc",
    "supportUrl": "https://sdkwork.com/support",
    "privacyPolicyUrl": "https://sdkwork.com/privacy",
    "termsOfServiceUrl": "https://sdkwork.com/terms",
    "appType": "APP_REACT",
    "versionSource": "package.json",
    "identifiers": {
      "packageName": null,
      "bundleId": null,
      "desktopAppId": null,
      "containerImage": null
    }
  },
  "backend": {
    "profileKey": "backend-root-admin",
    "ownerMode": "tenant",
    "grantMode": "current",
    "platform": "WEB",
    "appId": "sdkwork-messaging-pc",
    "tenantId": "100001",
    "organizationId": "0",
    "accessTokenPermissionScope": [
      "messaging.notifications.get",
      "messaging.notifications.post"
    ]
  },
  "runtime": {
    "family": "web",
    "framework": "react",
    "runtimes": ["WEB", "BROWSER"],
    "deliveryModes": ["WEB_URL"],
    "defaultPlatform": "WEB",
    "defaultArchitecture": "universal",
    "supportedDeploymentProfiles": ["standalone", "cloud"],
    "defaultDeploymentProfile": "standalone"
  },
  "publish": {
    "status": "DRAFT",
    "platforms": ["WEB"],
    "installPlatforms": ["WEB"],
    "config": {
      "workspaceRoot": "apps/sdkwork-messaging-pc",
      "framework": "react",
      "managedBy": "sdkwork-messaging"
    }
  },
  "release": {
    "currentVersion": "0.1.0",
    "defaultChannel": "DEV",
    "latest": { "DEV": "0.1.0" }
  },
  "security": {
    "checksumRequired": true,
    "signatureRequired": true,
    "sbomRequired": true
  },
  "metadata": {
    "standardOwner": "sdkwork-platform",
    "component": "sdkwork-messaging-pc",
    "surface": "pc",
    "deploymentConfig": "etc/sdkwork.deployment.config.json"
  }
}

