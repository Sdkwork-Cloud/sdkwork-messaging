{
  "extends": "./tsconfig.base.json",
  "include": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "apps/sdkwork-messaging-pc/**/*.ts",
    "apps/sdkwork-messaging-pc/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "sdks/**/generated/server-openapi"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  }
}
